# Server port
PORT=4000
# Set a PostgreSQL connection URL from Neon, Supabase, or another managed PostgreSQL host.
# If unset, the site still works and enquiries open in WhatsApp, but server-side storage is disabled.
DATABASE_URL=
# Set to true if your provider requires SSL (common for hosted PostgreSQL).
DATABASE_SSL=true
# Optional comma-separated allowed frontend origins for production, e.g. https://your-domain.vercel.app
CLIENT_ORIGIN=http://localhost:5173
