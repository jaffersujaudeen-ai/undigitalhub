{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-server",
    "noEmit": true,
    "types": [
      "node"
    ],
    "composite": true
  },
  "include": [
    "server"
  ]
}